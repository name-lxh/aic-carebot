# ROS 日志级别配置 —— 压掉刷屏
#
# ⚠️⚠️ 为什么必须有这个文件
#
# move_base 在规划失败时会**无限刷**：
#     [ERROR] Failed to get a plan.
#     [ERROR] NO PATH!
# 实测一分钟刷到 **100~400 MB**，几分钟就把 30 GB 的盘写满
# （~/.ros/log 涨到 17 GB），随后出现一串完全查不到原因的怪现象：
#     · sftp 上传静默写 0 字节（报 "size mismatch in put"）
#     · 异常 traceback 只打一半
#
# ⚠️ 我第一版用 `<rosparam>` 配，**没用** —— ROS 1 的日志级别
#    不走参数服务器，走的是 `ROSCONSOLE_CONFIG_FILE` 环境变量
#    指向的 log4cxx 配置文件。这是个很容易搞错的地方。
#
# ⚠️ 这不是"掩盖问题"：
#    规划失败会频繁重试，而重试日志**内容完全一样**，价值极低。
#    真正有用的信息（哪个目标点失败、为什么）在别处单独打：
#       · waypoint_nav 会打目标坐标
#       · sim_diag.py 能归因失败类型
#
# 调参时想看详细日志：把下面几行改成 DEBUG 即可。

log4j.logger.ros=WARN
log4j.logger.ros.rosout=WARN

# ---- 规划与代价地图：只留 FATAL，压掉重试刷屏 ----
log4j.logger.ros.move_base=FATAL
log4j.logger.ros.global_planner=FATAL
log4j.logger.ros.navfn=FATAL
log4j.logger.ros.costmap_2d=FATAL
log4j.logger.ros.dwa_local_planner=ERROR
log4j.logger.ros.base_local_planner=ERROR
log4j.logger.ros.rotate_recovery=ERROR
log4j.logger.ros.clear_costmap_recovery=ERROR

# ---- 定位：收敛过程很吵，压掉 ----
log4j.logger.ros.amcl=WARN

# ---- 我们自己的节点：保留 INFO（要看任务进度）----
log4j.logger.ros.waypoint_nav=INFO
log4j.logger.ros.mission_manager=INFO
log4j.logger.ros.sim_stubs=INFO
log4j.logger.ros.fake_sensors=INFO
