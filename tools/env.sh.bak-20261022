#!/bin/bash
# ============================================================================
#  env.sh —— LXH 包的统一下环境脚本（被其它脚本 source）
# ============================================================================
#  ⚠️⚠️ 为什么需要这个文件，而不是直接几行 source
#
#  catkin 的 `setup.sh` 会调自己的 `_setup_util.py`，它开头写着：
#      "reset environment variables by unrolling modifications
#       based on all workspaces in CMAKE_PREFIX_PATH"
#  —— **每 source 一个工作空间，就会把之前 source 过的剥掉**，
#     只保留"自己 + 基础 ROS"。
#
#  这台车上同时有 3 个需要共存的工作空间：
#      /home/ub/catkin_ws                     （37 包，主基线：驱动/导航/语音）
#      /home/ub/omniWheelCareRobot/rosCode    （43 包：astra 相机、robot_voice）
#      /home/ub/Hajimi/LXH/catkin_ws          （我们的 7 个 carebot_*）
#
#  实测过的错误顺序（踩过）：
#      source A; source B; **补路径**; source C
#      → C 的 unroll 把补的路径又剥掉了
#      → astra_launch 找不到 → eldercare_full.launch 解析失败
#      → 看起来像"缺包"，其实只是环境没配全
#
#  ✔ 正确顺序：
#      1. 先 source 完**所有** setup.bash（顺序无关，反正会被 unroll）
#      2. **最后**手工把三个 src 目录补进 ROS_PACKAGE_PATH
#
#  用法：
#      source /home/ub/Hajimi/LXH/env.sh
# ============================================================================

# 只在被 source 时生效
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    echo "请用 source 执行：source $0" >&2
    exit 1
fi

# source ROS 时 ROS_DISTRO 等变量可能未定义，临时放开 -u
_LXH_HAD_U=0
case $- in *u*) _LXH_HAD_U=1 ;; esac
set +u

# ---- 1. 探测 ROS 版本 ----------------------------------------------------
_LXH_DISTRO=""
for _d in kinetic melodic noetic; do
    if [ -f "/opt/ros/$_d/setup.bash" ]; then _LXH_DISTRO=$_d; break; fi
done
if [ -z "$_LXH_DISTRO" ]; then
    echo "[env.sh] [FAIL] 没找到 /opt/ros/*/setup.bash" >&2
    unset _d _LXH_DISTRO
    exit 1
fi

# ---- 2. 把所有 setup.bash source 完（顺序不重要）-------------------------
source "/opt/ros/$_LXH_DISTRO/setup.bash"

_LXH=/home/ub/Hajimi/LXH
_LXH_WS="$_LXH/catkin_ws"

for _s in /home/ub/catkin_ws/devel/setup.bash \
          /home/ub/omniWheelCareRobot/rosCode/devel/setup.bash \
          "$_LXH_WS/devel/setup.bash"; do
    [ -f "$_s" ] && source "$_s"
done

# ---- 3. ★ 最后重建 ROS_PACKAGE_PATH（顺序确定，且对抗 unroll）----------
#
# ⚠️⚠️ 为什么不是"检查已有就跳过"，而是**显式重建**
#
#  一开始写的是：
#      for p in ...; do
#          case ":$ROS_PACKAGE_PATH:" in *":$p:"*) ;;  # 已有就跳过
#          *) ROS_PACKAGE_PATH="$ROS_PACKAGE_PATH:$p";;
#          esac
#      done
#
#  结果顺序**还是错的**：因为上面 `source catkin_ws/devel/setup.bash`
#  已经自己把 `catkin_ws/src` 塞进了 ROS_PACKAGE_PATH，
#  等到循环时它"已存在"于是被跳过，而 rosCode 是后 append 的，
#  永远排在 catkin_ws 后面 → `rospack find art_imu_01` 仍然解析到**错的那份**。
#
#  所以这里改成：**先把要的路径按顺序拼好，再整个覆盖过去**。
#
# ⚠️ 顺序**有讲究**：rosCode 必须在 catkin_ws **前面**。
#
#  这台车上有**两份同名不同版本的 `art_imu_01`**：
#
#    /home/ub/catkin_ws/src/art_imu_01
#        节点 art_imu_node，launch demo.launch
#        参数 serial_port / baudrate(代码默认 500000 → 这台机器 termios 打不开)
#        是**另一种 IMU**（协议要求帧头 A5 0A 01 ... 0D 0A）的驱动
#
#    /home/ub/omniWheelCareRobot/rosCode/src/art_imu_01   ★ 本车实际用这个
#        节点 art_imu_01_node（源码 yesense_driver.cpp，YESENSE 模块）
#        launch imu_serial.launch
#        参数 imu_port / imu_baudrate(460800) / imu_topic(/imu_data)
#        额外发布 /imu/inertial_data /imu/nav_data /imu/sensor_data ...
#
#  实测：用 catkin_ws 那份，要么 "Unable to open port" 直接 abort，
#        要么串口通了但数据是垃圾（orientation 恒单位四元数、
#        angular_velocity.x = -22.67），抓原始字节**找不到 A5 0A 01 帧头**。
#
#  `edg_team/edg_start_all.sh`（另一个组在这台车上能跑的脚本）
#  也是把 rosCode/src 排在 catkin_ws/src 前面，与此一致。
_LXH_WANT="$_LXH_WS/src:/home/ub/omniWheelCareRobot/rosCode/src:/home/ub/catkin_ws/src"

# 保留原路径里"不是这几个工作空间 src"的段（比如 /opt/ros/kinetic/share）
_LXH_REST=""
_IFS_SAVE="$IFS"
IFS=':'
for _seg in ${ROS_PACKAGE_PATH:-}; do
    [ -n "$_seg" ] || continue
    case "$_seg" in
        "$_LXH_WS/src"|/home/ub/omniWheelCareRobot/rosCode/src|/home/ub/catkin_ws/src) ;;
        *) _LXH_REST="${_LXH_REST:+$_LXH_REST:}$_seg" ;;
    esac
done
IFS="$_IFS_SAVE"

# 只保留实际存在的目录
_LXH_ORDERED=""
_IFS_SAVE="$IFS"
IFS=':'
for _seg in $_LXH_WANT; do
    [ -d "$_seg" ] && _LXH_ORDERED="${_LXH_ORDERED:+$_LXH_ORDERED:}$_seg"
done
IFS="$_IFS_SAVE"

ROS_PACKAGE_PATH="${_LXH_ORDERED}${_LXH_REST:+:$_LXH_REST}"
export ROS_PACKAGE_PATH
unset _LXH_WANT _LXH_REST _LXH_ORDERED _seg _IFS_SAVE

# ---- 3b. ★ 同样重建 CMAKE_PREFIX_PATH -----------------------------------
#
# ⚠️ 这个变量**也必须**修，否则 C++ 节点找不到可执行文件。
#
#  踩过：`rospack find art_imu_01` 已经正确指向 rosCode 那份了，
#  但 roslaunch 仍报
#      ERROR: cannot launch node of type [art_imu_01/art_imu_01_node]:
#             can't locate node [art_imu_01_node] in package [art_imu_01]
#
#  原因：roslaunch 找 C++ 可执行文件不是只看包目录，它会用
#  `CMAKE_PREFIX_PATH` 去找各工作空间的 `devel/lib/<pkg>/`。
#  而 `CMAKE_PREFIX_PATH` **同样会被 catkin 的 unroll 干掉** ——
#  最后 source 的是 LXH 的 devel，于是它只剩
#      LXH/devel : catkin_ws/devel : /opt/ros/kinetic
#  `rosCode/devel` **消失了**，而 `art_imu_01_node` 二进制正躺在那：
#      /home/ub/omniWheelCareRobot/rosCode/devel/lib/art_imu_01/art_imu_01_node
#
#  → 把三个 devel 都补回去（rosCode 在前，保证优先命中它的二进制）。
_LXH_WANT_DEVEL="$_LXH_WS/devel:/home/ub/omniWheelCareRobot/rosCode/devel:/home/ub/catkin_ws/devel"
_LXH_CP=""
_IFS_SAVE="$IFS"
IFS=':'
for _seg in $_LXH_WANT_DEVEL; do
    [ -d "$_seg" ] && _LXH_CP="${_LXH_CP:+$_LXH_CP:}$_seg"
done
# 保留原来的非工作空间项（/opt/ros/kinetic 等）
for _seg in ${CMAKE_PREFIX_PATH:-}; do
    [ -n "$_seg" ] || continue
    case "$_seg" in
        "$_LXH_WS/devel"|/home/ub/omniWheelCareRobot/rosCode/devel|/home/ub/catkin_ws/devel) ;;
        *) _LXH_CP="${_LXH_CP:+$_LXH_CP:}$_seg" ;;
    esac
done
IFS="$_IFS_SAVE"
CMAKE_PREFIX_PATH="$_LXH_CP"
export CMAKE_PREFIX_PATH
unset _LXH_WANT_DEVEL _LXH_CP _seg _IFS_SAVE

# ---- 4. ROS 网络（本机自己当 master）-----------------------------------
# ⚠️ 这台车的 /etc/hosts 里 `ub` 指向 192.168.8.213（当前 IP）。
#    如果换网段，`ub` 可能解析到旧地址，roscore 会卡死无输出。
#    显式用 IP 最稳。可用 ROS_IP 环境变量覆盖。
: "${ROS_IP:=192.168.8.213}"
export ROS_IP
: "${ROS_MASTER_URI:=http://${ROS_IP}:11311}"
export ROS_MASTER_URI

# ---- 5. 恢复 -u ----------------------------------------------------------
[ "$_LXH_HAD_U" -eq 1 ] && set -u

unset _d _s _p _LXH_DISTRO _LXH_HAD_U

# 只在交互式下打印
if [ -n "${PS1:-}" ]; then
    echo "[env.sh] ROS=$ROS_DISTRO  ROS_IP=$ROS_IP"
    echo "[env.sh] 工作空间: LXH(carebot_*) + catkin_ws + omniWheelCareRobot"
fi
